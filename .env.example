# Copy this file to .env.local and fill it in. Never commit .env.local.
# On a host such as Vercel, add the same variables in its dashboard instead.

# The MongoDB Atlas connection string, with the database name after the host.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/uae_venture_guide?retryWrites=true&w=majority

# A long random string of at least 32 characters. Create one with: openssl rand -base64 48
JWT_SECRET=

# The address of the website, used in links inside emails.
APP_URL=http://localhost:3000

# Email over SMTP (optional; without it emails are printed in the terminal).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="UAE Venture Guide <your-address@gmail.com>"
