# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# every test and its setup, kept on this computer only
/tests/
/src/**/*.test.js
/playwright.config.mjs
/vitest.config.mjs

# pushes to the client's repository, kept on this computer only
/scripts/push-client.mjs

# docs kept on this computer only, except the project report
/docs/*
!/docs/Project-Documentation.docx

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.log
*.swp

# editors (each person keeps their own settings)
.idea/
.vscode/*
!.vscode/settings.json

# local tool files, kept on this computer only
/.impeccable/
/.claude/
/.cursor/
/.agents/
/.windsurf/
.aider*
/CLAUDE.md
/AGENTS.md
/DESIGN.md
/PRODUCT.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real secrets never go into git. Only the empty template is shared.
.env*
!.env.example
*credentials*.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local demo logins
*.local.txt
