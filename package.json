  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "create-admin": "node --env-file=.env.development scripts/create-admin.mjs",
    "seed:demo": "node --env-file=.env.development --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-demo.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:backup": "node scripts/backup-db.mjs",
    "push:mine": "git push https://github.com/muneebnawaz018/uae-venture-guide.git main:main",
    "push:client": "git push https://github.com/techproject181-blip/uae-venture-guide.git main:main",
    "push": "npm run push:mine && npm run push:client"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "mongoose": "^9.10.4",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "nodemailer": "^7.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "vitest": "^5.0.3"
  }
