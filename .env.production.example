# Production settings, loaded by `npm run build` and `npm run start`.
# Copy this file to .env.production and fill it in. Never commit .env.production.
# On a host such as Vercel, add the same variables in its dashboard instead.

# The hosted MongoDB connection string (for example from MongoDB Atlas).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/uae_venture_guide?retryWrites=true&w=majority

# A long random string of at least 32 characters. Create one with: openssl rand -base64 48
JWT_SECRET=

# The public address of the website, used in links inside emails.
APP_URL=https://your-domain.example

# Email over SMTP (for example a Gmail account with an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="UAE Venture Guide <your-address@gmail.com>"
