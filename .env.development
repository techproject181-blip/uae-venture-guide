# Development settings, loaded by `npm run dev`.
# Safe to commit: they only work with the local Docker database.
MONGODB_URI=mongodb://127.0.0.1:27018/uae_venture_guide_dev
JWT_SECRET=local-development-secret-not-for-production

# Links in emails point here.
APP_URL=http://localhost:3000
# No SMTP settings in development: emails are printed in the terminal instead.
